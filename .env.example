# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE FREE CONFIGURATION
# Create a free project at https://supabase.com and run /supabase/schema.sql
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# OFFICIAL COLLEGE EMAIL (SMTP) FOR TEAM LEADER CONFIRMATIONS
# Example for Google Workspace / Gmail: smtp.gmail.com, port 465, with an App Password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="esports@srustiacademy.edu.in"
SMTP_PASS="your-app-password"
SMTP_FROM="SAMT Campus Esports <esports@srustiacademy.edu.in>"

# OPTIONAL ADMIN PASSCODE FOR LOCAL PREVIEW MODE (when Supabase is not yet connected)
ADMIN_DEMO_PASSCODE="SAMT-2K26-ADMIN"
