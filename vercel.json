{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "regions": ["hnd1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "{supabase/schema.sql,public/assets/aistudio/SRUSTI_ESPORTS_f3d0bc97.png}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
